{"ann_id": "ann_098", "record_id": "XK_002721", "text": "忍冬丸。治渴疾愈，须预防发痈疽。\n忍冬草（不以多少，根茎花叶皆可用之，一名老公须，一名蜜啜花，一名金银花，一名左缠滕，水洗净用）上用米曲酒，于瓶内浸，以糠火煨一宿，取出晒干，入甘草少许，为末，即以所浸酒煮糊为丸，如梧桐子大。每服五十丸至百丸，酒饮任下。一方，用忍冬草煎服。此藤凌冬不凋，三月开花五出，黄白相间，微香，蒂带红。《外科精要》又以酒煮窨服，取时不犯铁气，服至大小肠通利，此药到得力。用干者，不及生者效速。仍治五种飞尸，酒研传疮亦好，但留一口泄毒瓦斯，真经效奇药也。此药不特治痈，亦能止渴，并五痔诸漏。", "span_entities": [{"surface_form": "忍冬丸", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "渴疾", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "忍冬草", "entity_type": "中药", "start": 17, "end": 20}, {"surface_form": "忍冬草", "entity_type": "中药", "start": 130, "end": 133}, {"surface_form": "渴", "entity_type": "疾病", "start": 5, "end": 6}, {"surface_form": "渴", "entity_type": "疾病", "start": 247, "end": 248}], "relations": [["忍冬丸", "治疗", "渴疾"], ["忍冬草", "治疗", "渴"]]}
{"ann_id": "ann_086", "record_id": "XK_000479", "text": "泽泻。【主治】主风寒湿痹。乳难消水。（本经）补虚损五劳。除五脏痞满。起阴气。止泄精消渴淋补女垢。心", "span_entities": [{"surface_form": "泽泻", "entity_type": "中药", "start": 0, "end": 2}, {"surface_form": "消渴", "entity_type": "疾病", "start": 41, "end": 43}], "relations": [["泽泻", "治疗", "消渴"]]}
{"ann_id": "ann_019", "record_id": "XK_001665", "text": "一人消中，日夜溺七八升，鹿角烧令焦为末，以酒调服五分，日三服，渐加至方寸匕。", "span_entities": [{"surface_form": "消中", "entity_type": "疾病", "start": 2, "end": 4}, {"surface_form": "鹿角", "entity_type": "中药", "start": 12, "end": 14}], "relations": [["鹿角", "治疗", "消中"]]}
{"ann_id": "ann_065", "record_id": "XK_000510", "text": "云实。味苦，无毒。主治消渴。花，杀精物，下水，烧之致鬼。久服益寿。一名员实，一名英，一名天豆。生河间。十月采，曝干。", "span_entities": [{"surface_form": "云实", "entity_type": "中药", "start": 0, "end": 2}, {"surface_form": "消渴", "entity_type": "疾病", "start": 11, "end": 13}], "relations": [["云实", "治疗", "消渴"]]}
{"ann_id": "ann_084", "record_id": "XK_000451", "text": "荆沥。辛、甘。入手少阴经。除风热，开经络，导痰涎，行血气，止消渴，解热痢。治心闷发热，头风旋运目眩，心头洋洋欲吐，中风失音，痰迷心窍，小儿心热惊痫。配竹沥、姜汁，治风热、风痰。（气虚不能食者用淡竹沥，气实能食者用黄荆沥。）取沥法∶用新采黄荆茎截尺余长，架于两砖上，中间烧火炙之，两头以器承取。热服，或入药中。令人不睡，气虚食少者忌用。", "span_entities": [{"surface_form": "荆沥", "entity_type": "中药", "start": 0, "end": 2}, {"surface_form": "荆沥", "entity_type": "中药", "start": 107, "end": 109}, {"surface_form": "消渴", "entity_type": "疾病", "start": 30, "end": 32}], "relations": [["荆沥", "治疗", "消渴"]]}
{"ann_id": "ann_072", "record_id": "XK_000471", "text": "主消渴客热，止小便利，治五噎膈气，烦闷吐逆，以芦根五两，水三盏煮一盏服，甚效。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 1, "end": 3}, {"surface_form": "芦根", "entity_type": "方药", "start": 23, "end": 25}], "relations": [["芦根", "治疗", "消渴"]]}
{"ann_id": "ann_001", "record_id": "XK_002012", "text": "棘刺丸。苦患风痿痹气，体不便，热烦满，少气消渴，加葳蕤、天冬、菟丝子。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 21, "end": 23}, {"surface_form": "棘刺丸", "entity_type": "方药", "start": 0, "end": 3}], "relations": [["棘刺丸", "治疗", "消渴"]]}
{"ann_id": "ann_040", "record_id": "XK_000659", "text": "治伤寒发汗后，小便不利，微热消渴者。五苓散方猪苓（去黑皮） 白术 赤茯苓（去黑皮各三分） 桂（去粗皮半两） 泽泻（一两一分）上五味，捣罗为散，每服三钱匕，熟水调下。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 14, "end": 16}, {"surface_form": "五苓散", "entity_type": "方药", "start": 18, "end": 21}], "relations": [["五苓散", "治疗", "消渴"]]}
{"ann_id": "ann_038", "record_id": "XK_000920", "text": "人参汤。治消渴。初因酒得。\n人参 甘草（半生半炙各一两） 上粗捣筛。 猪水。去滓澄清。取五升。同煎至二升半。\n去滓。渴即饮之。永瘥。", "span_entities": [{"surface_form": "人参汤", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}], "relations": [["人参汤", "治疗", "消渴"]]}
{"ann_id": "ann_067", "record_id": "XK_002882", "text": "牛黄甘露丸。治三焦渴疾，饮水无度，舌上皴裂，肌肉黄瘦，精神减退，小便多，腹胁朱砂（一两，成块者） 牛黄（一分） 铁粉（半两） 犀角（半两，锉） 丁香（半两） 胡桐泪（半两） 葳蕤（半两） 麝香（一分） 银箔（五十片） 地龙（半两） 槟榔牡蛎 苦参 石膏 锡兰纸 甘草（炙） 白 豆（各半两，慢火炒） 铅白霜（半两", "span_entities": [{"surface_form": "牛黄甘露丸", "entity_type": "方药", "start": 0, "end": 5}, {"surface_form": "三焦", "entity_type": "病位", "start": 7, "end": 9}, {"surface_form": "渴疾", "entity_type": "疾病", "start": 9, "end": 11}, {"surface_form": "饮水无度", "entity_type": "症状", "start": 12, "end": 16}, {"surface_form": "舌上皴裂", "entity_type": "症状", "start": 17, "end": 21}, {"surface_form": "肌肉黄瘦", "entity_type": "症状", "start": 22, "end": 26}, {"surface_form": "精神减退", "entity_type": "症状", "start": 27, "end": 31}, {"surface_form": "小便多", "entity_type": "症状", "start": 32, "end": 35}], "relations": [["牛黄甘露丸", "治疗", "渴疾"], ["渴疾", "表现", "饮水无度"], ["渴疾", "表现", "舌上皴裂"], ["渴疾", "表现", "肌肉黄瘦"], ["渴疾", "表现", "精神减退"], ["渴疾", "表现", "小便多"]]}
{"ann_id": "ann_071", "record_id": "XK_000873", "text": "铅丹散。治消渴不止。小便数。兼消中。心神烦闷。头痛。", "span_entities": [{"surface_form": "铅丹散", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "小便数", "entity_type": "症状", "start": 10, "end": 13}, {"surface_form": "消中", "entity_type": "疾病", "start": 15, "end": 17}], "relations": [["铅丹散", "治疗", "消渴"], ["铅丹散", "治疗", "消中"], ["消渴", "表现", "小便数"]]}
{"ann_id": "ann_003", "record_id": "XK_001832", "text": "又曰。脉浮。小便不利。微热消渴者。与五苓散利小便发汗。", "span_entities": [{"surface_form": "小便不利", "entity_type": "症状", "start": 6, "end": 10}, {"surface_form": "消渴", "entity_type": "疾病", "start": 13, "end": 15}, {"surface_form": "五苓散", "entity_type": "方药", "start": 18, "end": 21}], "relations": [["五苓散", "治疗", "消渴"], ["消渴", "表现", "小便不利"]]}
{"ann_id": "ann_016", "record_id": "XK_001233", "text": "黄连丸。治消渴饮水不知休。小便中如脂。舌干口渴。\n黄连（去须） 栝蒌根（各五两） 上为末。生地黄汁和剂。石臼内用木杵。涂酥捣匀热。丸如", "span_entities": [{"surface_form": "黄连丸", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "口渴", "entity_type": "症状", "start": 21, "end": 23}], "relations": [["黄连丸", "治疗", "消渴"], ["消渴", "表现", "口渴"]]}
{"ann_id": "ann_085", "record_id": "XK_002529", "text": "盖伤寒在表，不甚作渴，六七日传至厥阴为消渴者，渴饮水多，而小便少，乃热能消水也。朱氏曰∶脉浮而渴属太阳，有汗而渴属阳明，自利而渴属少阴，至于厥阴，则热之极矣。太阳无汗而渴，忌白虎，宜柴胡。阳明多汗而渴，戒五苓，宜竹叶石膏汤。若先呕后渴，则为欲解，当与水饮之。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 19, "end": 21}, {"surface_form": "竹叶石膏汤", "entity_type": "方药", "start": 106, "end": 111}, {"surface_form": "渴饮水多", "entity_type": "症状", "start": 23, "end": 27}, {"surface_form": "小便少", "entity_type": "症状", "start": 29, "end": 32}], "relations": [["消渴", "表现", "渴饮水多"], ["消渴", "表现", "小便少"]]}
{"ann_id": "ann_089", "record_id": "XK_002257", "text": "凡见消渴，便用热药，误人多矣，故《内经》应言渴者，皆如是，岂不昭晰欤！", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 2, "end": 4}], "relations": []}
{"ann_id": "ann_032", "record_id": "XK_001240", "text": "防己丸。治消渴瘥后。津液枯竭。身体浮虚。欲成水病。\n防己 猪苓（去黑皮） 郁李仁（汤浸去皮尖炒） 杏仁（去皮尖双仁炒各一两半） 栝蒌根赤炼蜜丸梧桐", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}], "relations": []}
{"ann_id": "ann_017", "record_id": "XK_002285", "text": "至于阴消之义，则未有知之者。凡阴阳血气之属，日见消败者，皆谓之消，此不可尽以火为言。如气厥论曰∶心移寒于肺为肺消，饮一溲二，死不治。此正以元气之衰，而金寒水冷，故水不化气，而气悉化水，讵非阳虚之症也。又如邪气脏腑病形篇曰∶五脏之脉细小者，皆为消瘅。岂以微小之脉，而为有余之阳症也。此《内经》阴消之义显然，而人多未察也。\n故古人虽以上焦属肺，中焦属胃，下焦属肾，皆从火治，而不知三焦之火，多有病本乎肾，而无不由乎命门者。夫命门为水火之腑，已水亏而为消渴者，以水不济火，则火不归源，故有火游于肺而为上消者，火游于胃而为中消者，火铄阴精而为下消者。是皆真阴不足，而水亏于下消症也。", "span_entities": [{"surface_form": "肺", "entity_type": "病位", "start": 52, "end": 53}, {"surface_form": "肺", "entity_type": "病位", "start": 54, "end": 55}, {"surface_form": "肺", "entity_type": "病位", "start": 168, "end": 169}, {"surface_form": "肺", "entity_type": "病位", "start": 244, "end": 245}, {"surface_form": "肺消", "entity_type": "疾病", "start": 54, "end": 56}, {"surface_form": "消瘅", "entity_type": "疾病", "start": 121, "end": 123}, {"surface_form": "胃", "entity_type": "病位", "start": 173, "end": 174}, {"surface_form": "胃", "entity_type": "病位", "start": 254, "end": 255}, {"surface_form": "肾", "entity_type": "病位", "start": 178, "end": 179}, {"surface_form": "肾", "entity_type": "病位", "start": 198, "end": 199}, {"surface_form": "三焦", "entity_type": "病位", "start": 188, "end": 190}, {"surface_form": "命门", "entity_type": "病位", "start": 205, "end": 207}, {"surface_form": "命门", "entity_type": "病位", "start": 210, "end": 212}, {"surface_form": "消渴", "entity_type": "疾病", "start": 223, "end": 225}, {"surface_form": "上消", "entity_type": "疾病", "start": 247, "end": 249}, {"surface_form": "中消", "entity_type": "疾病", "start": 257, "end": 259}, {"surface_form": "下消", "entity_type": "疾病", "start": 267, "end": 269}, {"surface_form": "下消", "entity_type": "疾病", "start": 282, "end": 284}, {"surface_form": "元气之衰", "entity_type": "病机", "start": 69, "end": 73}, {"surface_form": "真阴不足", "entity_type": "病机", "start": 273, "end": 277}], "relations": [["元气之衰", "导致", "肺消"], ["真阴不足", "导致", "消渴"], ["真阴不足", "导致", "上消"], ["真阴不足", "导致", "中消"], ["真阴不足", "导致", "下消"]]}
{"ann_id": "ann_094", "record_id": "XK_001027", "text": "夫消肾者。是肾脏虚惫。膀胱冷损。脾胃气衰。客邪热毒转炽。纵然食物。不生肌肤。\n腿胫消细。骨节酸疼。小便滑数。故曰消肾也", "span_entities": [{"surface_form": "消肾", "entity_type": "疾病", "start": 1, "end": 3}, {"surface_form": "消肾", "entity_type": "疾病", "start": 56, "end": 58}, {"surface_form": "肾", "entity_type": "病位", "start": 2, "end": 3}, {"surface_form": "肾", "entity_type": "病位", "start": 6, "end": 7}, {"surface_form": "肾", "entity_type": "病位", "start": 57, "end": 58}, {"surface_form": "肾脏虚惫", "entity_type": "病机", "start": 6, "end": 10}, {"surface_form": "膀胱", "entity_type": "病位", "start": 11, "end": 13}, {"surface_form": "膀胱冷损", "entity_type": "病机", "start": 11, "end": 15}, {"surface_form": "脾", "entity_type": "病位", "start": 16, "end": 17}, {"surface_form": "脾胃气衰", "entity_type": "病机", "start": 16, "end": 20}, {"surface_form": "胃", "entity_type": "病位", "start": 17, "end": 18}, {"surface_form": "客邪热毒转炽", "entity_type": "病机", "start": 21, "end": 27}, {"surface_form": "不生肌肤", "entity_type": "症状", "start": 33, "end": 37}, {"surface_form": "腿胫消细", "entity_type": "症状", "start": 39, "end": 43}, {"surface_form": "骨节酸疼", "entity_type": "症状", "start": 44, "end": 48}, {"surface_form": "小便滑数", "entity_type": "症状", "start": 49, "end": 53}], "relations": [["肾脏虚惫", "导致", "消肾"], ["膀胱冷损", "导致", "消肾"], ["脾胃气衰", "导致", "消肾"], ["客邪热毒转炽", "导致", "消肾"], ["消肾", "表现", "腿胫消细"], ["消肾", "表现", "骨节酸疼"], ["消肾", "表现", "小便滑数"], ["消肾", "表现", "不生肌肤"]]}
{"ann_id": "ann_092", "record_id": "XK_000845", "text": "治积湿热毒甚者。身体面目黄。心胁腹满。呕吐不能饮。上为咳血衄血。下为大小便血。肠风痔痿。三焦壅滞闷。瘅热消渴。传化失常。", "span_entities": [{"surface_form": "三焦壅滞闷", "entity_type": "病机", "start": 44, "end": 49}, {"surface_form": "消渴", "entity_type": "疾病", "start": 52, "end": 54}], "relations": []}
{"ann_id": "ann_077", "record_id": "XK_002252", "text": "若饮水多而小便多者，名曰消渴。若饮食多而不甚饥，小便数而渐瘦者，名曰消中。\n若渴而饮水不绝，腿消瘦而小便有脂液者，名曰肾消。如此三消者，其燥热一也，但有微甚耳。", "span_entities": [{"surface_form": "饮水多", "entity_type": "症状", "start": 1, "end": 4}, {"surface_form": "小便多", "entity_type": "症状", "start": 5, "end": 8}, {"surface_form": "消渴", "entity_type": "疾病", "start": 12, "end": 14}, {"surface_form": "渴", "entity_type": "症状", "start": 13, "end": 14}, {"surface_form": "渴", "entity_type": "症状", "start": 39, "end": 40}, {"surface_form": "饮食多", "entity_type": "症状", "start": 16, "end": 19}, {"surface_form": "不甚饥", "entity_type": "症状", "start": 20, "end": 23}, {"surface_form": "小便数", "entity_type": "症状", "start": 24, "end": 27}, {"surface_form": "渐瘦", "entity_type": "症状", "start": 28, "end": 30}, {"surface_form": "消中", "entity_type": "疾病", "start": 34, "end": 36}, {"surface_form": "饮水不绝", "entity_type": "症状", "start": 41, "end": 45}, {"surface_form": "腿消瘦", "entity_type": "症状", "start": 46, "end": 49}, {"surface_form": "小便有脂液", "entity_type": "症状", "start": 50, "end": 55}, {"surface_form": "肾消", "entity_type": "疾病", "start": 59, "end": 61}, {"surface_form": "三消", "entity_type": "疾病", "start": 64, "end": 66}, {"surface_form": "燥热", "entity_type": "病机", "start": 69, "end": 71}], "relations": [["燥热", "导致", "三消"], ["消渴", "表现", "饮水多"], ["消渴", "表现", "小便多"], ["消中", "表现", "饮食多"], ["消中", "表现", "不甚饥"], ["消中", "表现", "小便数"], ["消中", "表现", "渐瘦"], ["肾消", "表现", "渴"], ["肾消", "表现", "饮水不绝"], ["肾消", "表现", "腿消瘦"], ["肾消", "表现", "小便有脂液"]]}

{"ann_id": "ann_052", "record_id": "XK_002054", "text": "金不换木香丸。大戟（五钱） 芫花（炒五钱） 甘遂（五钱） 黑丑（头末二钱） 生大黄（五钱） 青皮（五钱）陈皮（五钱） 南木香（五钱） 青木香（五钱） 胡椒（一钱病合倍用） 川椒（去目五钱） 槟榔（五钱） 益智仁（五钱） 射干（三钱） 桑白皮（五钱） 苦葶苈（五钱炒） 大腹皮（五钱） 泽泻（五钱） 木通（去皮五钱） 连翘（五钱） 砂仁（五钱） 巴豆（去壳半生半熟五钱）上二十二味为末。醋煮面糊为丸。如梧子大。每服五十丸。壮盛人加七八十丸。第一消头而肿。五更初。用葱白酒送下。第二消中膈胸腹肿。五更初。用陈皮汤送下。第三消脐以下脚肿五更初。用桑白皮汤送下。", "span_entities": [], "relations": []}
{"ann_id": "ann_096", "record_id": "XK_000367", "text": "消渴引饮。韭苗炒。或作羹。勿入盐。入酱无妨。吃至十斤。即住。极效。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 0, "end": 2}, {"surface_form": "韭苗", "entity_type": "中药", "start": 5, "end": 7}], "relations": [["韭苗", "治疗", "消渴"]]}
{"ann_id": "ann_005", "record_id": "XK_000229", "text": "真珠三百八十六。治惊热疔疮，下死胎胞衣消渴。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 19, "end": 21}, {"surface_form": "真珠", "entity_type": "中药", "start": 0, "end": 2}], "relations": [["真珠", "治疗", "消渴"]]}
{"ann_id": "ann_027", "record_id": "XK_000811", "text": "白茅根。《药性论》云∶臣。茅∶破血，主消渴，根∶治五日华子云∶茅针凉，通小肠，痈毒，软疖不作头，浓煎和酒服。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 19, "end": 21}, {"surface_form": "白茅根", "entity_type": "中药", "start": 0, "end": 3}], "relations": [["白茅根", "治疗", "消渴"]]}
{"ann_id": "ann_002", "record_id": "XK_002776", "text": "（二百九）即黄麻也，亦名大麻。味甘平，性滑利。能润心肺，滋五脏，利大肠风热结燥，行水气，通小便湿热，秘涩五淋，去积血，下气，除风湿顽痹，关节血燥拘挛，止消渴，通乳汁，产难催生，经脉阻滞。凡病多燥涩者宜之。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 76, "end": 78}, {"surface_form": "黄麻", "entity_type": "中药", "start": 6, "end": 8}], "relations": [["黄麻", "治疗", "消渴"]]}
{"ann_id": "ann_059", "record_id": "XK_001376", "text": "蜘蛛散方。趺阳脉浮而数，浮则为气，数则消谷而大坚，气盛则溲数，溲数则坚，坚数相搏，即为消渴。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 43, "end": 45}, {"surface_form": "蜘蛛散方", "entity_type": "方药", "start": 0, "end": 4}], "relations": []}
{"ann_id": "ann_009", "record_id": "XK_001274", "text": "玄参散。（出圣惠方）治渴利后头面身上。遍生热毒疮。", "span_entities": [{"surface_form": "渴利", "entity_type": "疾病", "start": 11, "end": 13}, {"surface_form": "玄参散", "entity_type": "方药", "start": 0, "end": 3}], "relations": [["玄参散", "治疗", "渴利"]]}
{"ann_id": "ann_088", "record_id": "XK_001287", "text": "大理气丸。枸杞酒 治五内邪气消渴。风湿下脑。胁气头痛。坚筋骨。强阴利大小便。填骨髓。长肌肉水。破积瘀脓气肿痹。悉主之。", "span_entities": [{"surface_form": "枸杞酒", "entity_type": "方药", "start": 5, "end": 8}, {"surface_form": "消渴", "entity_type": "疾病", "start": 14, "end": 16}], "relations": [["枸杞酒", "治疗", "消渴"]]}
{"ann_id": "ann_050", "record_id": "XK_000736", "text": "治猝患消渴，小便利数。田螺饮方田螺（活者一升）上一味。以水一斗，煮至二升，不问食前后，稍稍饮汁，一方用螺五升，水一斗半，浸之经宿，渴即饮浸螺汁，每日一度易水并螺。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 3, "end": 5}, {"surface_form": "田螺饮", "entity_type": "方药", "start": 11, "end": 14}], "relations": [["田螺饮", "治疗", "消渴"]]}
{"ann_id": "ann_054", "record_id": "XK_002178", "text": "饮水多而小便反多者，水消于下，故名下消也。上、中二消属热，惟下消寒热兼之，以肾为水火之藏也。饮一溲一，其中无热消耗可知矣。故与肾气丸从阴中温养其阳，使肾阴摄水则不直趋下源，肾气上蒸则能化生津液，何消渴之有耶！", "span_entities": [{"surface_form": "饮水多", "entity_type": "症状", "start": 0, "end": 3}, {"surface_form": "小便反多", "entity_type": "症状", "start": 4, "end": 8}, {"surface_form": "下消", "entity_type": "疾病", "start": 17, "end": 19}, {"surface_form": "下消", "entity_type": "疾病", "start": 30, "end": 32}, {"surface_form": "寒热", "entity_type": "病机", "start": 32, "end": 34}, {"surface_form": "肾", "entity_type": "病位", "start": 38, "end": 39}, {"surface_form": "肾", "entity_type": "病位", "start": 63, "end": 64}, {"surface_form": "肾", "entity_type": "病位", "start": 75, "end": 76}, {"surface_form": "肾", "entity_type": "病位", "start": 86, "end": 87}, {"surface_form": "肾气丸", "entity_type": "方药", "start": 63, "end": 66}, {"surface_form": "消渴", "entity_type": "疾病", "start": 98, "end": 100}], "relations": [["肾气丸", "治疗", "下消"], ["下消", "表现", "饮水多"], ["下消", "表现", "小便反多"]]}
{"ann_id": "ann_082", "record_id": "XK_001049", "text": "柴胡散。治消渴。上焦虚热。心中烦躁。\n柴胡（去苗） 葛根（锉） 芦根（锉） 地骨皮 百合（干者） 知母（切焙） 葳蕤桑根白皮（咀。每服四钱。水一盏。入生地黄半分。煎至七分。去滓食后温服。", "span_entities": [{"surface_form": "柴胡散", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "上焦虚热", "entity_type": "病机", "start": 8, "end": 12}, {"surface_form": "心中烦躁", "entity_type": "症状", "start": 13, "end": 17}], "relations": [["柴胡散", "治疗", "消渴"]]}
{"ann_id": "ann_030", "record_id": "XK_002111", "text": "肾沥散。治肾消发渴，小便数，腰疼痛。", "span_entities": [{"surface_form": "肾消", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "肾沥散", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "发渴", "entity_type": "症状", "start": 7, "end": 9}, {"surface_form": "小便数", "entity_type": "症状", "start": 10, "end": 13}, {"surface_form": "腰疼痛", "entity_type": "症状", "start": 14, "end": 17}], "relations": [["肾消", "表现", "发渴"], ["肾消", "表现", "小便数"], ["肾消", "表现", "腰疼痛"], ["肾沥散", "治疗", "肾消"]]}
{"ann_id": "ann_044", "record_id": "XK_001819", "text": "绛雪散。治消渴，饮水无度，小便数者。大有神效。\n黄芩 黄丹 汉防己 栝蒌实（各等分）上为细末，每服二钱，汤浆水调下，临卧时并进三二服，即止。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "绛雪散", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "饮水无度", "entity_type": "症状", "start": 8, "end": 12}, {"surface_form": "小便数", "entity_type": "症状", "start": 13, "end": 16}], "relations": [["消渴", "表现", "饮水无度"], ["消渴", "表现", "小便数"], ["绛雪散", "治疗", "消渴"]]}
{"ann_id": "ann_018", "record_id": "XK_002819", "text": "消肾为病，比诸消为重，古方谓之强中。又谓之内消。多因恣意色欲，或饵金石，肾气既衰，石气独在，精水无所养，故常发虚阳，不交精出，小便无度，唇口干焦，黄饮，吞玄兔丹。八味丸、鹿茸丸、加减肾气丸、小菟丝子丸、灵砂丹，皆可选用。未效，黄 饮加苁蓉、五味、山茱萸各四分，荠茏汤、苁蓉丸、天王补心丹、双补丸、肾沥散、金银箔丸、白茯苓丸。", "span_entities": [{"surface_form": "消肾", "entity_type": "疾病", "start": 0, "end": 2}, {"surface_form": "强中", "entity_type": "疾病", "start": 15, "end": 17}, {"surface_form": "内消", "entity_type": "疾病", "start": 21, "end": 23}, {"surface_form": "虚阳", "entity_type": "症状", "start": 55, "end": 57}, {"surface_form": "小便无度", "entity_type": "症状", "start": 63, "end": 67}, {"surface_form": "唇口干焦", "entity_type": "症状", "start": 68, "end": 72}, {"surface_form": "八味丸", "entity_type": "方药", "start": 81, "end": 84}, {"surface_form": "鹿茸丸", "entity_type": "方药", "start": 85, "end": 88}, {"surface_form": "加减肾气丸", "entity_type": "方药", "start": 89, "end": 94}, {"surface_form": "小菟丝子丸", "entity_type": "方药", "start": 95, "end": 100}, {"surface_form": "灵砂丹", "entity_type": "方药", "start": 101, "end": 104}, {"surface_form": "黄饮", "entity_type": "方药", "start": 73, "end": 75}, {"surface_form": "荠茏汤", "entity_type": "方药", "start": 130, "end": 133}, {"surface_form": "苁蓉丸", "entity_type": "方药", "start": 134, "end": 137}, {"surface_form": "天王补心丹", "entity_type": "方药", "start": 138, "end": 143}, {"surface_form": "双补丸", "entity_type": "方药", "start": 144, "end": 147}, {"surface_form": "肾沥散", "entity_type": "方药", "start": 148, "end": 151}, {"surface_form": "金银箔丸", "entity_type": "方药", "start": 152, "end": 156}, {"surface_form": "白茯苓丸", "entity_type": "方药", "start": 157, "end": 161}], "relations": [["消肾", "表现", "小便无度"], ["消肾", "表现", "唇口干焦"], ["消肾", "表现", "虚阳"], ["八味丸", "治疗", "消肾"], ["鹿茸丸", "治疗", "消肾"], ["加减肾气丸", "治疗", "消肾"], ["小菟丝子丸", "治疗", "消肾"], ["灵砂丹", "治疗", "消肾"], ["黄饮", "治疗", "消肾"], ["荠茏汤", "治疗", "消肾"], ["苁蓉丸", "治疗", "消肾"], ["天王补心丹", "治疗", "消肾"], ["双补丸", "治疗", "消肾"], ["肾沥散", "治疗", "消肾"], ["金银箔丸", "治疗", "消肾"], ["白茯苓丸", "治疗", "消肾"]]}
{"ann_id": "ann_090", "record_id": "XK_001634", "text": "经脉渴而欲饮，饥不能食，属足少阴，而仲景乃谓厥阴病消渴，饮不欲食，种种皆殊。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 25, "end": 27}], "relations": []}
{"ann_id": "ann_037", "record_id": "XK_000805", "text": "石。味辛甘，大热，生温熟热，有毒。主寒热，鼠 蚀疮，死肌，风痹，腹中坚，癖邪气除热，明目，下气。除膈中热，止消渴，益肝气，破积聚痼冷腹痛，去鼻中息肉。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 54, "end": 56}], "relations": []}
{"ann_id": "ann_011", "record_id": "XK_001749", "text": "其有余于胃。则消谷善饥。（火盛中消。）溺色黄。（胃热下入膀胱。）", "span_entities": [{"surface_form": "胃", "entity_type": "病位", "start": 4, "end": 5}, {"surface_form": "胃", "entity_type": "病位", "start": 24, "end": 25}, {"surface_form": "中消", "entity_type": "疾病", "start": 15, "end": 17}, {"surface_form": "胃热", "entity_type": "病机", "start": 24, "end": 26}, {"surface_form": "膀胱", "entity_type": "病位", "start": 28, "end": 30}], "relations": [["胃热", "导致", "中消"]]}
{"ann_id": "ann_073", "record_id": "XK_002254", "text": "世谓消渴之证，乃肠胃之外燥热，痞闭其渗泄之道路，水虽入肠胃之内，不能渗泄于外，故小便数而复渴。此数句，足以尽其理也，试取《内经》凡言渴者，尽明之矣。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 2, "end": 4}, {"surface_form": "肠胃", "entity_type": "病位", "start": 8, "end": 10}, {"surface_form": "肠胃", "entity_type": "病位", "start": 27, "end": 29}, {"surface_form": "燥热", "entity_type": "病机", "start": 12, "end": 14}, {"surface_form": "小便数", "entity_type": "症状", "start": 40, "end": 43}, {"surface_form": "复渴", "entity_type": "症状", "start": 44, "end": 46}], "relations": [["燥热", "导致", "消渴"], ["燥热", "涉及", "肠胃"], ["消渴", "表现", "小便数"], ["消渴", "表现", "复渴"]]}
{"ann_id": "ann_010", "record_id": "XK_001667", "text": "此痰食壅塞于中，复加辛热，助其淫火，始见阴虚，未传消中之患也。", "span_entities": [{"surface_form": "消中", "entity_type": "疾病", "start": 25, "end": 27}, {"surface_form": "阴虚", "entity_type": "病机", "start": 20, "end": 22}], "relations": []}
{"ann_id": "ann_080", "record_id": "XK_001769", "text": "心气内热而有寒来击，遂内热更甚，发为消瘅。瘅，热也。内热消瘦，故曰消瘅。", "span_entities": [{"surface_form": "心气内热", "entity_type": "病机", "start": 0, "end": 4}, {"surface_form": "消瘅", "entity_type": "疾病", "start": 18, "end": 20}, {"surface_form": "消瘅", "entity_type": "疾病", "start": 33, "end": 35}, {"surface_form": "消瘦", "entity_type": "症状", "start": 28, "end": 30}], "relations": [["心气内热", "导致", "消瘅"], ["消瘅", "表现", "消瘦"]]}
{"ann_id": "ann_049", "record_id": "XK_003012", "text": "玉石部上品。白石英味甘微温。主治消渴，阴痿不足，逆，胸膈间久寒。益气，除风湿痹。久服轻身、长年。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 16, "end": 18}, {"surface_form": "白石英", "entity_type": "中药", "start": 6, "end": 9}], "relations": [["白石英", "治疗", "消渴"]]}
{"ann_id": "ann_031", "record_id": "XK_000019", "text": "乌古瓦。以水煮及渍汁饮，止消渴。取屋上年久者良。（新附）", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 13, "end": 15}, {"surface_form": "乌古瓦", "entity_type": "中药", "start": 0, "end": 3}], "relations": [["乌古瓦", "治疗", "消渴"]]}
{"ann_id": "ann_057", "record_id": "XK_000542", "text": "黄石华。味甘，无毒。主治阴痿，消渴，膈中热，去百毒。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 15, "end": 17}, {"surface_form": "黄石华", "entity_type": "中药", "start": 0, "end": 3}], "relations": [["黄石华", "治疗", "消渴"]]}
{"ann_id": "ann_015", "record_id": "XK_002774", "text": "雷丸。（二百二）味苦微涩，性凉。能降火生津，清痰涎咳嗽，治口疮喉痹烦热，止消渴吐血衄血，便血尿血，湿热痢血，及妇人崩淋，经血不止，小儿疳热、口疳热疮、湿烂诸疮，敛肌长肉，亦杀诸虫。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 37, "end": 39}, {"surface_form": "雷丸", "entity_type": "中药", "start": 0, "end": 2}], "relations": [["雷丸", "治疗", "消渴"]]}
{"ann_id": "ann_058", "record_id": "XK_002685", "text": "李东恒方。870。胃热消渴丹溪消渴膏：泻火生津益血之品合成。花粉 川连 藕汁 生地汁 牛乳 姜汁 蜜煎膏冲服。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 11, "end": 13}, {"surface_form": "消渴", "entity_type": "疾病", "start": 15, "end": 17}, {"surface_form": "泻火生津益血", "entity_type": "治法", "start": 19, "end": 25}, {"surface_form": "胃热", "entity_type": "病机", "start": 9, "end": 11}, {"surface_form": "胃", "entity_type": "病位", "start": 9, "end": 10}, {"surface_form": "丹溪消渴膏", "entity_type": "方药", "start": 13, "end": 18}], "relations": [["泻火生津益血", "主治", "消渴"], ["胃热", "导致", "消渴"], ["胃热", "涉及", "胃"], ["丹溪消渴膏", "治疗", "消渴"]]}
{"ann_id": "ann_070", "record_id": "XK_001018", "text": "猪肚黄连丸。治久消渴。变为消中者。饮食到胃。实时消化。小", "span_entities": [{"surface_form": "猪肚黄连丸", "entity_type": "方药", "start": 0, "end": 5}, {"surface_form": "消渴", "entity_type": "疾病", "start": 8, "end": 10}, {"surface_form": "消中", "entity_type": "疾病", "start": 13, "end": 15}], "relations": [["猪肚黄连丸", "治疗", "消渴"], ["猪肚黄连丸", "治疗", "消中"]]}
{"ann_id": "ann_041", "record_id": "XK_001011", "text": "黄连丸。治消中。小便数。", "span_entities": [{"surface_form": "消中", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "黄连丸", "entity_type": "方药", "start": 0, "end": 3}], "relations": [["黄连丸", "治疗", "消中"]]}
{"ann_id": "ann_083", "record_id": "XK_001200", "text": "大黄丸。治消渴腹胀。利大小肠。\n川大黄（三两锉碎微炒） 栝蒌根 槟榔 枳壳（麸炒微黄去瓤各一两） 芎 （二分）桂心", "span_entities": [{"surface_form": "大黄丸", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}], "relations": [["大黄丸", "治疗", "消渴"]]}
{"ann_id": "ann_004", "record_id": "XK_000730", "text": "治骨蒸消渴消中，热中渴利，心热，风虚热、传尸，苦参丸方苦参（五两） 黄连（去须） 知母（锉焙） 栝蒌根 牡蛎粉 麦门冬（去心焙各三两）上六味，捣罗为末，以生牛乳和丸，如梧桐子大，曝干，每服十五丸，或二十丸。食后浆水下。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 3, "end": 5}, {"surface_form": "消中", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "渴利", "entity_type": "疾病", "start": 10, "end": 12}, {"surface_form": "苦参丸", "entity_type": "方药", "start": 23, "end": 26}], "relations": [["苦参丸", "治疗", "消渴"], ["苦参丸", "治疗", "消中"], ["苦参丸", "治疗", "渴利"]]}
{"ann_id": "ann_014", "record_id": "XK_000632", "text": "《病源论》云∶消渴者，渴而不小便是也。由少服五石诸丸散，积经年岁，石热结于肾中，水而《千金方》云∶论曰∶凡积久兴酒，未有不成消渴。然则大寒凝海而酒不冻，明其酒性酷热由己。饮啖无度，咀（才与反）嚼酢酱，不择酸（苏官反，酢也）咸，积年长夜，酣兴不KT，遂使三焦（《短剧方》云∶说曰∶少时服五石诸丸散者，积经年岁，人转虚耗（呼到反）。石热结于肾中消渴之兴终不痿弱，液自出；亦作KT 疸之病。凡如此等，宜服猪肾荠 （脐二音）汤，制其肾中石势，将又云∶铅丹散治消渴止小便方∶铅丹〔（一名铅华，和名多尔，《本草》云∶朱雀精也）二分〕 栝蒌（十分） 泽泻〔（音昔五分〕凡八物，冶下筛，酒服方寸匕，日三。不知，稍增，年壮服半匕。得病一年服药一日愈，二又云∶治日饮一石许，小便不通，栝（古活反）楼丸方∶栝蒌（三分） 铅丹（三分） 葛根（三分） 附子（一分，炮）凡四物，冶下筛，蜜（在本书）丸如梧子，饮服十丸，日三。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 7, "end": 9}, {"surface_form": "消渴", "entity_type": "疾病", "start": 62, "end": 64}, {"surface_form": "消渴", "entity_type": "疾病", "start": 170, "end": 172}, {"surface_form": "消渴", "entity_type": "疾病", "start": 225, "end": 227}, {"surface_form": "渴", "entity_type": "症状", "start": 8, "end": 9}, {"surface_form": "渴", "entity_type": "症状", "start": 11, "end": 12}, {"surface_form": "渴", "entity_type": "症状", "start": 63, "end": 64}, {"surface_form": "渴", "entity_type": "症状", "start": 171, "end": 172}, {"surface_form": "渴", "entity_type": "症状", "start": 226, "end": 227}, {"surface_form": "肾", "entity_type": "病位", "start": 37, "end": 38}, {"surface_form": "肾", "entity_type": "病位", "start": 168, "end": 169}, {"surface_form": "肾", "entity_type": "病位", "start": 200, "end": 201}, {"surface_form": "肾", "entity_type": "病位", "start": 212, "end": 213}, {"surface_form": "铅丹散", "entity_type": "方药", "start": 221, "end": 224}], "relations": [["消渴", "表现", "渴"], ["铅丹散", "治疗", "消渴"]]}
{"ann_id": "ann_036", "record_id": "XK_001820", "text": "人参散。治肾消，善饮而食后数小便溺者。", "span_entities": [{"surface_form": "人参散", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "肾消", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "善饮", "entity_type": "症状", "start": 8, "end": 10}, {"surface_form": "小便溺", "entity_type": "症状", "start": 14, "end": 17}], "relations": [["人参散", "治疗", "肾消"], ["肾消", "表现", "善饮"], ["肾消", "表现", "小便溺"]]}
{"ann_id": "ann_068", "record_id": "XK_001010", "text": "茯神丸。治消中烦热。小便数。", "span_entities": [{"surface_form": "茯神丸", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "消中", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "小便数", "entity_type": "症状", "start": 10, "end": 13}, {"surface_form": "烦热", "entity_type": "症状", "start": 7, "end": 9}], "relations": [["茯神丸", "治疗", "消中"], ["消中", "表现", "烦热"], ["消中", "表现", "小便数"]]}
{"ann_id": "ann_062", "record_id": "XK_001051", "text": "麦门冬汤。治消渴小便多。烦躁不得眠。\n麦冬（一两） 土瓜根（二两） 小麦（二两） 竹叶（一把） 上用水七升。煮取三升半。再服。", "span_entities": [{"surface_form": "麦门冬汤", "entity_type": "方药", "start": 0, "end": 4}, {"surface_form": "消渴", "entity_type": "疾病", "start": 6, "end": 8}, {"surface_form": "小便多", "entity_type": "症状", "start": 8, "end": 11}, {"surface_form": "烦躁不得眠", "entity_type": "症状", "start": 12, "end": 17}], "relations": [["麦门冬汤", "治疗", "消渴"], ["消渴", "表现", "小便多"], ["消渴", "表现", "烦躁不得眠"]]}
{"ann_id": "ann_055", "record_id": "XK_000630", "text": "成消中半发附骨者，或未觉肉色已殃，已殃者痈疽之甚也。", "span_entities": [{"surface_form": "消中", "entity_type": "疾病", "start": 1, "end": 3}], "relations": []}
{"ann_id": "ann_024", "record_id": "XK_001136", "text": "冷汤。治胃中热消渴。利小便。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 7, "end": 9}], "relations": []}
{"ann_id": "ann_053", "record_id": "XK_002994", "text": "此人薄皮肤，而目坚固以深者，长冲直肠，其心刚，刚则多怒，怒则气上逆，胸中蓄积，血气逆留，髋皮充肌，血脉不行，转而为热，热则消肌肤，故为消瘅。", "span_entities": [{"surface_form": "消瘅", "entity_type": "疾病", "start": 67, "end": 69}], "relations": []}
{"ann_id": "ann_099", "record_id": "XK_002159", "text": "如因肥甘石药而渴者，《奇病论》曰∶有口甘者，病名为何？岐伯曰∶此五气之所溢也，病名脾瘅。瘅为热也，脾热则四脏不禀，故五气上溢也。先因脾热，故曰脾瘅。又《经》曰∶五味入口，藏于胃，脾为之行其精气，津液在脾，故令人口甘也。此肥美之所发也。此人必数食甘美而多肥也。肥者令人内热，甘者令人中满，故其气上溢，转而为消渴。", "span_entities": [{"surface_form": "脾瘅", "entity_type": "疾病", "start": 41, "end": 43}, {"surface_form": "脾瘅", "entity_type": "疾病", "start": 71, "end": 73}, {"surface_form": "脾", "entity_type": "病位", "start": 41, "end": 42}, {"surface_form": "脾", "entity_type": "病位", "start": 49, "end": 50}, {"surface_form": "脾", "entity_type": "病位", "start": 66, "end": 67}, {"surface_form": "脾", "entity_type": "病位", "start": 71, "end": 72}, {"surface_form": "脾", "entity_type": "病位", "start": 89, "end": 90}, {"surface_form": "脾", "entity_type": "病位", "start": 100, "end": 101}, {"surface_form": "脾热", "entity_type": "病机", "start": 49, "end": 51}, {"surface_form": "脾热", "entity_type": "病机", "start": 66, "end": 68}, {"surface_form": "五气上溢", "entity_type": "病机", "start": 58, "end": 62}, {"surface_form": "消渴", "entity_type": "疾病", "start": 152, "end": 154}, {"surface_form": "气上溢", "entity_type": "病机", "start": 59, "end": 62}, {"surface_form": "气上溢", "entity_type": "病机", "start": 145, "end": 148}], "relations": [["脾热", "导致", "脾瘅"], ["脾热", "涉及", "脾"], ["五气上溢", "导致", "脾瘅"], ["气上溢", "导致", "消渴"]]}
{"ann_id": "ann_093", "record_id": "XK_002877", "text": "消症三消之病形何如。曰。消之为病。一原于心火炽炎。火甚于上。为膈膜之消。甚于中。为肠胃之消。甚于下。为膏液之消。甚于外。为肌肉之消。上甚不已。则消及肺。中甚不已。则消及脾。下甚不已。则消及肝肾。外甚不已。则消及筋骨。四脏皆消甚。则其心始自焚而死矣。然其病之始。皆由不节嗜欲。不慎喜怒。膏粱爆炙。酒酪乳。湿热之气。浸淫燔灼。郁成燥热。气不宣平。故其传变之形。为饮水多而小便多。曰消渴。胃中津液干枯。不能上荣舌本也。为善饥多食而渴。小便数而消瘦。曰消中。胃中热极。所食之物。随火而化也。为渴而饮水不绝。腿消瘦而小便有脂液。曰肾消。是燥热并及于胃底大小肠。故脂液凝浊。清阳与浊阴不能分疏也。三消之中。上中可治。下消最难治。然饮一溲未二。犹可治。饮一溲二。不可治矣。又三消久而小便不臭。反作甘气。在溺桶中涌沸。其病为重。更有浮在溺面如猪脂油溅在桶边。如烛泪。此精不禁而真元竭矣。然何以甘气为重。大抵水在天地与人身。皆有甘有咸。甘为生气。而咸为死气。小便本咸而反甘。", "span_entities": [{"surface_form": "三消", "entity_type": "疾病", "start": 2, "end": 4}, {"surface_form": "三消", "entity_type": "疾病", "start": 292, "end": 294}, {"surface_form": "三消", "entity_type": "疾病", "start": 330, "end": 332}, {"surface_form": "心", "entity_type": "病位", "start": 20, "end": 21}, {"surface_form": "心", "entity_type": "病位", "start": 116, "end": 117}, {"surface_form": "心火炽炎", "entity_type": "病机", "start": 20, "end": 24}, {"surface_form": "膈膜", "entity_type": "病位", "start": 31, "end": 33}, {"surface_form": "肠胃", "entity_type": "病位", "start": 41, "end": 43}, {"surface_form": "膏液", "entity_type": "病位", "start": 51, "end": 53}, {"surface_form": "肌肉", "entity_type": "病位", "start": 61, "end": 63}, {"surface_form": "肺", "entity_type": "病位", "start": 74, "end": 75}, {"surface_form": "脾", "entity_type": "病位", "start": 84, "end": 85}, {"surface_form": "肝", "entity_type": "病位", "start": 94, "end": 95}, {"surface_form": "肾", "entity_type": "病位", "start": 95, "end": 96}, {"surface_form": "肾", "entity_type": "病位", "start": 260, "end": 261}, {"surface_form": "筋骨", "entity_type": "病位", "start": 105, "end": 107}, {"surface_form": "不节嗜欲", "entity_type": "病机", "start": 132, "end": 136}, {"surface_form": "不慎喜怒", "entity_type": "病机", "start": 137, "end": 141}, {"surface_form": "膏粱爆炙", "entity_type": "病机", "start": 142, "end": 146}, {"surface_form": "湿热之气", "entity_type": "病机", "start": 151, "end": 155}, {"surface_form": "郁成燥热", "entity_type": "病机", "start": 161, "end": 165}, {"surface_form": "饮水多", "entity_type": "症状", "start": 179, "end": 182}, {"surface_form": "小便多", "entity_type": "症状", "start": 183, "end": 186}, {"surface_form": "消渴", "entity_type": "疾病", "start": 188, "end": 190}, {"surface_form": "胃中津液干枯", "entity_type": "病机", "start": 191, "end": 197}, {"surface_form": "善饥多食而渴", "entity_type": "症状", "start": 207, "end": 213}, {"surface_form": "小便数而消瘦", "entity_type": "症状", "start": 214, "end": 220}, {"surface_form": "消中", "entity_type": "疾病", "start": 222, "end": 224}, {"surface_form": "渴而饮水不绝", "entity_type": "症状", "start": 242, "end": 248}, {"surface_form": "腿消瘦而小便有脂液", "entity_type": "症状", "start": 249, "end": 258}, {"surface_form": "肾消", "entity_type": "疾病", "start": 260, "end": 262}, {"surface_form": "小肠", "entity_type": "病位", "start": 272, "end": 274}, {"surface_form": "小便不臭", "entity_type": "症状", "start": 334, "end": 338}], "relations": [["消渴", "表现", "饮水多"], ["消渴", "表现", "小便多"], ["消中", "表现", "善饥多食而渴"], ["消中", "表现", "小便数而消瘦"], ["肾消", "表现", "渴而饮水不绝"], ["肾消", "表现", "腿消瘦而小便有脂液"], ["三消", "表现", "小便不臭"], ["心火炽炎", "导致", "三消"], ["不节嗜欲", "导致", "三消"], ["不慎喜怒", "导致", "三消"], ["膏粱爆炙", "导致", "三消"], ["湿热之气", "导致", "三消"], ["郁成燥热", "导致", "三消"]]}
{"ann_id": "ann_022", "record_id": "XK_001727", "text": "肾气虚则为洞泄。精血不足。则为消瘅。", "span_entities": [{"surface_form": "消瘅", "entity_type": "疾病", "start": 15, "end": 17}, {"surface_form": "肾气虚", "entity_type": "病机", "start": 0, "end": 3}, {"surface_form": "精血不足", "entity_type": "病机", "start": 8, "end": 12}], "relations": [["精血不足", "导致", "消瘅"], ["肾气虚", "导致", "消瘅"]]}
{"ann_id": "ann_048", "record_id": "XK_002854", "text": "服三剂后，改用四神丸。善食善饿是谷消，烦闷饮一溲二是肾消 ，终非吉象。", "span_entities": [{"surface_form": "肾消", "entity_type": "疾病", "start": 26, "end": 28}, {"surface_form": "饮一溲二", "entity_type": "症状", "start": 21, "end": 25}], "relations": [["肾消", "表现", "饮一溲二"]]}
{"ann_id": "ann_013", "record_id": "XK_000641", "text": "桑椹 《本草》云∶苏敬曰∶味甘，寒，无毒，单食主消渴。", "span_entities": [{"surface_form": "桑椹", "entity_type": "中药", "start": 0, "end": 2}, {"surface_form": "消渴", "entity_type": "疾病", "start": 24, "end": 26}], "relations": [["桑椹", "治疗", "消渴"]]}
{"ann_id": "ann_021", "record_id": "XK_001989", "text": "陈粟米∶味苦。寒、无毒。主胃中热，消渴，利小便。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 17, "end": 19}, {"surface_form": "陈粟米", "entity_type": "中药", "start": 0, "end": 3}], "relations": [["陈粟米", "治疗", "消渴"]]}
{"ann_id": "ann_087", "record_id": "XK_000240", "text": "天花粉。滑痰解渴（古方多用治消渴），生肌排脓，消肿，行水通经，止小便利，（膀胱热解，则水行而小便不数）。", "span_entities": [{"surface_form": "天花粉", "entity_type": "中药", "start": 0, "end": 3}, {"surface_form": "消渴", "entity_type": "疾病", "start": 14, "end": 16}], "relations": [["天花粉", "治疗", "消渴"]]}
{"ann_id": "ann_035", "record_id": "XK_002823", "text": "长石。主身热，胃中结气，四肢寒厥，利小便，通血脉，明目，去翳眇，下三虫，杀蛊毒，止消渴，下气，除胁肋肺间邪气。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 41, "end": 43}, {"surface_form": "长石", "entity_type": "中药", "start": 0, "end": 2}], "relations": [["长石", "治疗", "消渴"]]}
{"ann_id": "ann_056", "record_id": "XK_002234", "text": "1。玉液汤。治消渴。消渴，即西医所谓糖尿病，忌食甜物。\n生山药（一两） 生黄 （五钱） 知母（六钱） 生鸡内金（二钱，捣细） 葛根（钱半） 五味子（三钱）天花粉（三钱）消渴之证，多由于元气不升，此方乃升元气以止渴者也。方中以黄 为主，得葛根能升元气。而又佐以山药、知母、花粉以大滋真阴。使之阳升而阴应，自有云行雨施之妙也。用鸡内金者，因此证尿中皆含有糖质，用之以助脾胃强健，化饮食中糖质，为津液也。用五味者，取其酸收之性，大能封固肾关，不使水饮急于下趋也", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 7, "end": 9}, {"surface_form": "消渴", "entity_type": "疾病", "start": 10, "end": 12}, {"surface_form": "消渴", "entity_type": "疾病", "start": 84, "end": 86}, {"surface_form": "玉液汤", "entity_type": "方药", "start": 2, "end": 5}, {"surface_form": "元气不升", "entity_type": "病机", "start": 92, "end": 96}, {"surface_form": "升元气", "entity_type": "治法", "start": 100, "end": 103}, {"surface_form": "升元气", "entity_type": "治法", "start": 121, "end": 124}], "relations": [["玉液汤", "治疗", "消渴"], ["元气不升", "导致", "消渴"], ["升元气", "主治", "消渴"]]}
{"ann_id": "ann_074", "record_id": "XK_002887", "text": "猪苓汤。治上消下淋者。", "span_entities": [{"surface_form": "猪苓汤", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "上消", "entity_type": "疾病", "start": 5, "end": 7}], "relations": [["猪苓汤", "治疗", "上消"]]}
{"ann_id": "ann_039", "record_id": "XK_001286", "text": "苦参散。治骨蒸消渴。消中热中。渴利心热。风虚热。传尸。", "span_entities": [{"surface_form": "苦参散", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "消渴", "entity_type": "疾病", "start": 7, "end": 9}, {"surface_form": "消中", "entity_type": "疾病", "start": 10, "end": 12}], "relations": [["苦参散", "治疗", "消渴"], ["苦参散", "治疗", "消中"]]}
{"ann_id": "ann_034", "record_id": "XK_002002", "text": "补肝汤方。治肝气不足，两胁下满，筋急不得大息，四肢厥冷，发抢心腹痛，目不明了，及妇人心痛，乳痈，膝热，消渴，爪甲枯，口面青者。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 51, "end": 53}, {"surface_form": "补肝汤", "entity_type": "方药", "start": 0, "end": 3}], "relations": [["补肝汤", "治疗", "消渴"]]}
{"ann_id": "ann_078", "record_id": "XK_001129", "text": "龙朱散。治心脾热渴。面赤口干。宜服之。\n马牙硝（半斤） 川芒硝（四两） 寒水石（四两） 石膏（三两） 上件药以水五升浸三日。\n用银器中煎至水尽后。去寒水石及石膏。阴干别入龙脑半两。朱砂一两。同研为末。不计时候。蜜水调下一钱。兼治喉痹肿痛甚妙。", "span_entities": [{"surface_form": "龙朱散", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "心脾热渴", "entity_type": "疾病", "start": 5, "end": 9}], "relations": [["龙朱散", "治疗", "心脾热渴"]]}
{"ann_id": "ann_081", "record_id": "XK_002464", "text": "上消者。舌上赤裂。大渴引饮。逆调论谓心移热于肺。传为鬲消者是也。以白虎加人参汤治之。\n中消者。善食而瘦自汗。大便硬。小便数。瘅成为消中者是也。以调胃承气汤治之。下消者。烦躁引饮。耳叶焦干。小便如膏。此肾消也。六味丸治之。古人治三消之法。详别如此。", "span_entities": [{"surface_form": "上消", "entity_type": "疾病", "start": 0, "end": 2}, {"surface_form": "舌上赤裂", "entity_type": "症状", "start": 4, "end": 8}, {"surface_form": "大渴引饮", "entity_type": "症状", "start": 9, "end": 13}, {"surface_form": "心移热于肺", "entity_type": "病机", "start": 18, "end": 23}, {"surface_form": "鬲消", "entity_type": "疾病", "start": 26, "end": 28}, {"surface_form": "白虎加人参汤", "entity_type": "方药", "start": 33, "end": 39}, {"surface_form": "中消", "entity_type": "疾病", "start": 43, "end": 45}, {"surface_form": "善食而瘦", "entity_type": "症状", "start": 47, "end": 51}, {"surface_form": "自汗", "entity_type": "症状", "start": 51, "end": 53}, {"surface_form": "大便硬", "entity_type": "症状", "start": 54, "end": 57}, {"surface_form": "小便数", "entity_type": "症状", "start": 58, "end": 61}, {"surface_form": "瘅成", "entity_type": "病机", "start": 62, "end": 64}, {"surface_form": "消中", "entity_type": "疾病", "start": 65, "end": 67}, {"surface_form": "调胃承气汤", "entity_type": "方药", "start": 72, "end": 77}, {"surface_form": "下消", "entity_type": "疾病", "start": 80, "end": 82}, {"surface_form": "烦躁引饮", "entity_type": "症状", "start": 84, "end": 88}, {"surface_form": "耳叶焦干", "entity_type": "症状", "start": 89, "end": 93}, {"surface_form": "小便如膏", "entity_type": "症状", "start": 94, "end": 98}, {"surface_form": "肾消", "entity_type": "疾病", "start": 100, "end": 102}, {"surface_form": "六味丸", "entity_type": "方药", "start": 104, "end": 107}, {"surface_form": "三消", "entity_type": "疾病", "start": 113, "end": 115}], "relations": [["白虎加人参汤", "治疗", "上消"], ["调胃承气汤", "治疗", "中消"], ["六味丸", "治疗", "下消"], ["心移热于肺", "导致", "鬲消"], ["瘅成", "导致", "消中"], ["上消", "表现", "舌上赤裂"], ["上消", "表现", "大渴引饮"], ["中消", "表现", "善食而瘦"], ["中消", "表现", "自汗"], ["中消", "表现", "大便硬"], ["中消", "表现", "小便数"], ["下消", "表现", "烦躁引饮"], ["下消", "表现", "耳叶焦干"], ["下消", "表现", "小便如膏"]]}
{"ann_id": "ann_075", "record_id": "XK_001155", "text": "土瓜根丸。治消渴。饮水过度。烦热不解。心神恍惚。眠卧不安", "span_entities": [{"surface_form": "土瓜根丸", "entity_type": "方药", "start": 0, "end": 4}, {"surface_form": "消渴", "entity_type": "疾病", "start": 6, "end": 8}, {"surface_form": "饮水过度", "entity_type": "症状", "start": 9, "end": 13}, {"surface_form": "烦热不解", "entity_type": "症状", "start": 14, "end": 18}, {"surface_form": "心神恍惚", "entity_type": "症状", "start": 19, "end": 23}, {"surface_form": "眠卧不安", "entity_type": "症状", "start": 24, "end": 28}], "relations": [["土瓜根丸", "治疗", "消渴"], ["消渴", "表现", "饮水过度"], ["消渴", "表现", "烦热不解"], ["消渴", "表现", "心神恍惚"], ["消渴", "表现", "眠卧不安"]]}
{"ann_id": "ann_028", "record_id": "XK_001090", "text": "人参散。治消渴。口舌干燥烦热。\n人参（二分去芦头） 地骨皮（一两） 赤茯苓（三分） 麦门冬（三两去心） 甘草（二分炙微赤两） 上为散。", "span_entities": [{"surface_form": "人参散", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "口舌干燥", "entity_type": "症状", "start": 8, "end": 12}, {"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}], "relations": [["人参散", "治疗", "消渴"], ["消渴", "表现", "口舌干燥"]]}
{"ann_id": "ann_064", "record_id": "XK_001040", "text": "宣补丸。枸杞子丸 治消肾久渴不瘥。困乏小便滑数。心神虚烦。\n枸杞子 白茯苓 黄 （锉各一两） 鸡 （一两半微炙） 栝蒌根（三分） 泽泻 牡丹山前子（各三", "span_entities": [{"surface_form": "枸杞子丸", "entity_type": "方药", "start": 4, "end": 8}, {"surface_form": "消肾", "entity_type": "疾病", "start": 10, "end": 12}, {"surface_form": "困乏", "entity_type": "症状", "start": 17, "end": 19}, {"surface_form": "久渴不瘥", "entity_type": "症状", "start": 12, "end": 16}, {"surface_form": "小便滑数", "entity_type": "症状", "start": 19, "end": 23}, {"surface_form": "心神虚烦", "entity_type": "症状", "start": 24, "end": 28}], "relations": [["枸杞子丸", "治疗", "消肾"], ["消肾", "表现", "困乏"], ["消肾", "表现", "久渴不瘥"], ["消肾", "表现", "小便滑数"], ["消肾", "表现", "心神虚烦"]]}
{"ann_id": "ann_079", "record_id": "XK_002045", "text": "脉直前而中散绝者，病消渴。（又云∶病浸淫疮。）", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 10, "end": 12}], "relations": []}
{"ann_id": "ann_020", "record_id": "XK_002287", "text": "手足阳明热结而病消渴，火之为害，已论之矣。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 8, "end": 10}], "relations": []}
{"ann_id": "ann_007", "record_id": "XK_001684", "text": "为呕血。为飧泄。为煎厥薄厥阳厥。为胸满胁痛。食则气逆不下。为喘陷烦心。为消瘅。为肥气。为目暴盲。耳暴闭。", "span_entities": [{"surface_form": "消瘅", "entity_type": "疾病", "start": 36, "end": 38}], "relations": []}
{"ann_id": "ann_008", "record_id": "XK_001432", "text": "夫消渴者，枯燥之病也。凡渴而多饮为上消，肺热也；多食善饥为中消，胃热也；渴而小便数，膏浊不禁为下消，肾热也。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 1, "end": 3}, {"surface_form": "多饮", "entity_type": "症状", "start": 14, "end": 16}, {"surface_form": "上消", "entity_type": "疾病", "start": 17, "end": 19}, {"surface_form": "肺", "entity_type": "病位", "start": 20, "end": 21}, {"surface_form": "中消", "entity_type": "疾病", "start": 29, "end": 31}, {"surface_form": "胃", "entity_type": "病位", "start": 32, "end": 33}, {"surface_form": "胃热", "entity_type": "病机", "start": 32, "end": 34}, {"surface_form": "小便数", "entity_type": "症状", "start": 38, "end": 41}, {"surface_form": "膏浊不禁", "entity_type": "症状", "start": 42, "end": 46}, {"surface_form": "下消", "entity_type": "疾病", "start": 47, "end": 49}, {"surface_form": "肾", "entity_type": "病位", "start": 50, "end": 51}, {"surface_form": "肺热", "entity_type": "病机", "start": 20, "end": 22}, {"surface_form": "肾热", "entity_type": "病机", "start": 50, "end": 52}], "relations": [["胃热", "涉及", "胃"], ["肺热", "涉及", "肺"], ["肾热", "涉及", "肾"], ["多饮", "提示", "肺热"], ["小便数", "提示", "肾热"], ["膏浊不禁", "提示", "肾热"], ["消渴", "表现", "多饮"], ["消渴", "表现", "小便数"], ["消渴", "表现", "膏浊不禁"], ["上消", "表现", "多饮"], ["下消", "表现", "小便数"], ["下消", "表现", "膏浊不禁"], ["肺热", "导致", "上消"], ["胃热", "导致", "中消"], ["肾热", "导致", "下消"]]}
{"ann_id": "ann_069", "record_id": "XK_002137", "text": "此谓大渴饮水，而小便多也。其人先患劳损，大病之后，肾气虚则热，热乘之则肾燥，肾燥则渴，渴则引水，肾虚则不能制水，故饮水数升，小便亦数升，名曰渴利也。", "span_entities": [{"surface_form": "渴", "entity_type": "症状", "start": 3, "end": 4}, {"surface_form": "渴", "entity_type": "症状", "start": 41, "end": 42}, {"surface_form": "渴", "entity_type": "症状", "start": 43, "end": 44}, {"surface_form": "渴", "entity_type": "症状", "start": 70, "end": 71}, {"surface_form": "小便多", "entity_type": "症状", "start": 8, "end": 11}, {"surface_form": "肾", "entity_type": "病位", "start": 25, "end": 26}, {"surface_form": "肾", "entity_type": "病位", "start": 35, "end": 36}, {"surface_form": "肾", "entity_type": "病位", "start": 38, "end": 39}, {"surface_form": "肾", "entity_type": "病位", "start": 48, "end": 49}, {"surface_form": "肾气虚", "entity_type": "病机", "start": 25, "end": 28}, {"surface_form": "肾燥", "entity_type": "病机", "start": 35, "end": 37}, {"surface_form": "肾燥", "entity_type": "病机", "start": 38, "end": 40}, {"surface_form": "肾虚", "entity_type": "病机", "start": 48, "end": 50}, {"surface_form": "渴利", "entity_type": "疾病", "start": 70, "end": 72}], "relations": [["渴利", "表现", "渴"], ["渴利", "表现", "小便多"], ["小便多", "提示", "肾气虚"]]}
{"ann_id": "ann_047", "record_id": "XK_002517", "text": "瘅成为消中。\n瘅，湿热也。湿热内积，故为消中。王注∶善食而瘦，乃食 也。", "span_entities": [{"surface_form": "消中", "entity_type": "疾病", "start": 3, "end": 5}, {"surface_form": "消中", "entity_type": "疾病", "start": 20, "end": 22}, {"surface_form": "湿热", "entity_type": "病机", "start": 9, "end": 11}, {"surface_form": "湿热", "entity_type": "病机", "start": 13, "end": 15}], "relations": [["湿热", "导致", "消中"]]}
{"ann_id": "ann_026", "record_id": "XK_001959", "text": "左尺得数，消渴不止，小便黄赤。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "小便黄赤", "entity_type": "症状", "start": 10, "end": 14}], "relations": [["消渴", "表现", "小便黄赤"]]}
{"ann_id": "ann_042", "record_id": "XK_000132", "text": "黄参。疗肠胃中冷，心腹鼓痛，胸胁逆满，霍乱吐逆，调中，止消渴，通血脉，破坚积，令人不忘。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 28, "end": 30}, {"surface_form": "黄参", "entity_type": "中药", "start": 0, "end": 2}], "relations": [["黄参", "治疗", "消渴"]]}
{"ann_id": "ann_023", "record_id": "XK_001773", "text": "故其气上溢转，转为消渴，治之以兰，兰除陈气。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 9, "end": 11}, {"surface_form": "兰", "entity_type": "中药", "start": 15, "end": 16}, {"surface_form": "兰", "entity_type": "中药", "start": 17, "end": 18}], "relations": [["兰", "治疗", "消渴"]]}
{"ann_id": "ann_100", "record_id": "XK_000227", "text": "蚕茧。甘，温，无毒。治血淋血崩，止消渴反胃。疗诸疳疮，杀诸蛔虫。烧灰酒服，治痈肿无头，二枚出二头也。", "span_entities": [{"surface_form": "蚕茧", "entity_type": "中药", "start": 0, "end": 2}, {"surface_form": "消渴", "entity_type": "疾病", "start": 17, "end": 19}], "relations": [["蚕茧", "治疗", "消渴"]]}
{"ann_id": "ann_060", "record_id": "XK_002356", "text": "贝母，苦泻心火，辛散肺郁，消膈上稠痰，久咳嗽者立效，散心中逆气，多愁郁者殊功，时疾黄胆疝瘕喉痹，清气化痰，除热解毒，吐血咯血，肺痿肺痈，散郁通乳，清心润肺，恶疮诸毒并疗，乳痈瘿 必用，止消渴烦热，敷人面疮效，为散结除热解毒化痰之要药。", "span_entities": [{"surface_form": "贝母", "entity_type": "中药", "start": 0, "end": 2}, {"surface_form": "消渴", "entity_type": "疾病", "start": 93, "end": 95}], "relations": [["贝母", "治疗", "消渴"]]}
{"ann_id": "ann_025", "record_id": "XK_001134", "text": "茯神汤。（出千金方）治胃腑实热。常渴引饮。泄热止渴。\n茯神（二两外台作茯苓） 栝蒌根 生麦门冬（各五两） 葳蕤 知母（各四两） 生地黄（六两） 小麦（二升） 大枣（三十枚） 淡竹叶（切三升） 上 咀。水三斗。煮小麦竹叶取九升。去滓下药。煮取得四升。分四服。服时不问早晚。渴即进。非但止胃渴。通治患热渴者。", "span_entities": [{"surface_form": "茯神汤", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "常渴引饮", "entity_type": "症状", "start": 16, "end": 20}, {"surface_form": "泄热止渴", "entity_type": "治法", "start": 21, "end": 25}, {"surface_form": "热渴", "entity_type": "疾病", "start": 148, "end": 150}], "relations": [["茯神汤", "治疗", "热渴"], ["热渴", "表现", "常渴引饮"], ["泄热止渴", "主治", "热渴"]]}
{"ann_id": "ann_063", "record_id": "XK_002315", "text": "发热消渴者，以参甘归芍麦冬栝蒌汤主之。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 2, "end": 4}, {"surface_form": "参甘归芍麦冬栝蒌汤", "entity_type": "方药", "start": 7, "end": 16}], "relations": [["参甘归芍麦冬栝蒌汤", "治疗", "消渴"]]}
{"ann_id": "ann_033", "record_id": "XK_001238", "text": "紫苏汤。治消渴后。遍身浮肿。心膈不利。\n紫苏茎叶 桑根白皮（锉） 赤茯苓（去黑皮各一两） 羚羊角（镑） 槟榔（锉各三分） 木香二两）上咀。每服四钱。水一盏。生姜半分切。煎至八分。去滓温服。不拘时。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "紫苏汤", "entity_type": "方药", "start": 0, "end": 3}], "relations": [["紫苏汤", "治疗", "消渴"]]}
{"ann_id": "ann_006", "record_id": "XK_000867", "text": "治消渴不问年月深浅。困笃者。宜服此。\n铁粉丸（二两研） 鸡 （一两微炒） 土瓜根（一两） 苦参（三分） 黄连（三分） 麦门十片）栝蒌不计时", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 1, "end": 3}, {"surface_form": "铁粉丸", "entity_type": "方药", "start": 19, "end": 22}], "relations": [["铁粉丸", "治疗", "消渴"]]}
{"ann_id": "ann_051", "record_id": "XK_000841", "text": "水仙丹。治水火不足。精神恍惚。怔忡健忘。遗精白浊。小便淋沥。消渴吐白芨（一两锉用麻油一小盏同入铫子内煎令药焦黑色为度去药更煎油良久以木箸点油向冷水中成花不散为度如未更煎良久入盏内收之） 朱砂（不拘多少细研水飞过） 木通（令为细末一两） 上件。将前油和研细朱砂、木通。看多少和如软面相似。用浓皂角水洗药剂数遍", "span_entities": [{"surface_form": "水仙丹", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "消渴", "entity_type": "疾病", "start": 30, "end": 32}], "relations": [["水仙丹", "治疗", "消渴"]]}
{"ann_id": "ann_091", "record_id": "XK_001574", "text": "周慎斋治一人。知饱不知饥。胸膈饱闷。脾虚也。常起火。喉痛。口唇生疮。牙根作胀齿缝出血。火在上。上盛也。骨酸痛。不能久立。鸡鸣精自遗。下虚也。上盛下虚。所谓阳精下降其人夭。名曰下消。善治不若善养。用补中益气汤以散上焦之火。六味汤以实下焦之肾。所以敛火归本也。", "span_entities": [{"surface_form": "阳精下降", "entity_type": "病机", "start": 77, "end": 81}, {"surface_form": "上盛下虚", "entity_type": "病机", "start": 70, "end": 74}, {"surface_form": "知饱不知饥", "entity_type": "症状", "start": 7, "end": 12}, {"surface_form": "喉痛", "entity_type": "症状", "start": 26, "end": 28}, {"surface_form": "胸膈饱闷", "entity_type": "症状", "start": 13, "end": 17}, {"surface_form": "口唇生疮", "entity_type": "症状", "start": 29, "end": 33}, {"surface_form": "骨酸痛", "entity_type": "症状", "start": 51, "end": 54}, {"surface_form": "牙根作胀齿缝出血", "entity_type": "症状", "start": 34, "end": 42}, {"surface_form": "不能久立", "entity_type": "症状", "start": 55, "end": 59}, {"surface_form": "鸡鸣精自遗", "entity_type": "症状", "start": 60, "end": 65}, {"surface_form": "下消", "entity_type": "疾病", "start": 87, "end": 89}, {"surface_form": "补中益气汤", "entity_type": "方药", "start": 98, "end": 103}, {"surface_form": "六味汤", "entity_type": "方药", "start": 110, "end": 113}], "relations": [["补中益气汤", "治疗", "下消"], ["六味汤", "治疗", "下消"], ["上盛下虚", "导致", "下消"], ["下消", "表现", "喉痛"], ["下消", "表现", "胸膈饱闷"], ["下消", "表现", "口唇生疮"], ["下消", "表现", "骨酸痛"], ["下消", "表现", "不能久立"], ["下消", "表现", "鸡鸣精自遗"], ["下消", "表现", "知饱不知饥"], ["下消", "表现", "牙根作胀齿缝出血"]]}
{"ann_id": "ann_095", "record_id": "XK_001225", "text": "黄连丸。治消肾小便滑数。白浊。心神烦躁。", "span_entities": [{"surface_form": "黄连丸", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "消肾", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "小便滑数", "entity_type": "症状", "start": 7, "end": 11}, {"surface_form": "白浊", "entity_type": "症状", "start": 12, "end": 14}, {"surface_form": "心神烦躁", "entity_type": "症状", "start": 15, "end": 19}], "relations": [["黄连丸", "治疗", "消肾"], ["消肾", "表现", "小便滑数"], ["消肾", "表现", "白浊"], ["消肾", "表现", "心神烦躁"]]}
{"ann_id": "ann_066", "record_id": "XK_001074", "text": "麦门冬饮。治膈消胸中烦渴。津液燥少。短气多渴。\n麦门冬（去心焙） 栝蒌根（一作实） 知母 甘草（炙） 五味子 生干地黄（焙） 人参葛根去滓", "span_entities": [{"surface_form": "麦门冬饮", "entity_type": "方药", "start": 0, "end": 4}, {"surface_form": "膈消", "entity_type": "疾病", "start": 6, "end": 8}, {"surface_form": "胸中烦渴", "entity_type": "症状", "start": 8, "end": 12}, {"surface_form": "津液燥少", "entity_type": "症状", "start": 13, "end": 17}, {"surface_form": "短气多渴", "entity_type": "症状", "start": 18, "end": 22}], "relations": [["麦门冬饮", "治疗", "膈消"], ["膈消", "表现", "胸中烦渴"], ["膈消", "表现", "津液燥少"], ["膈消", "表现", "短气多渴"]]}
{"ann_id": "ann_097", "record_id": "XK_002197", "text": "五苓散附茵陈五苓散。【注】是方也， 及太阳邪热入腑， 水气不化， 膀胱表里药也。 治水逆，水入则吐； 一治消渴， 水入则消。 夫膀胱者， 津液之腑， 气化则能出矣。 邪热入之， 若水盛则水壅不化而水蓄于上， 膀胱之气化不行，致不便不利也。 若热盛则水为热耗， 而水消于上， 膀胱之津液告竭，致小便不利也。 水入吐者， 是水盛于热也； 水入消者， 是热盛于水也。二证皆小便不利， 故均得而主之。", "span_entities": [{"surface_form": "五苓散", "entity_type": "方药", "start": 0, "end": 3}, {"surface_form": "五苓散", "entity_type": "方药", "start": 6, "end": 9}, {"surface_form": "茵陈五苓散", "entity_type": "方药", "start": 4, "end": 9}, {"surface_form": "消渴", "entity_type": "疾病", "start": 53, "end": 55}, {"surface_form": "水入则消", "entity_type": "症状", "start": 57, "end": 61}], "relations": [["五苓散", "治疗", "消渴"], ["茵陈五苓散", "治疗", "消渴"], ["消渴", "表现", "水入则消"]]}
{"ann_id": "ann_076", "record_id": "XK_000157", "text": "脑髓。挤乳汁，润心肺，解消渴，补寒冷虚乏；造", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 12, "end": 14}], "relations": []}
{"ann_id": "ann_045", "record_id": "XK_000561", "text": "味苦咸，寒，无毒。主大热，消渴狂烦，除邪，及下蛊毒，柔肌肤，去五脏肠胃留热，结气，心下坚，食已呕逆，喘满，明目，目痛。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 13, "end": 15}], "relations": []}
{"ann_id": "ann_061", "record_id": "XK_002242", "text": "《神农本草经》谓主消渴者，以其滋阴壮水而渴自止也；谓其主肢体浮肿者，以其寒滑能通利水道而肿自消也；谓其益气者，以其能除食气之壮火而气自得其益也。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 9, "end": 11}], "relations": []}
{"ann_id": "ann_012", "record_id": "XK_002420", "text": "更兼口味作甜，经名脾瘅，粘痰稠腻，气窒不利，皆湿热混处上中焦显象。", "span_entities": [{"surface_form": "脾瘅", "entity_type": "疾病", "start": 9, "end": 11}, {"surface_form": "粘痰稠腻", "entity_type": "症状", "start": 12, "end": 16}, {"surface_form": "气窒不利", "entity_type": "症状", "start": 17, "end": 21}, {"surface_form": "湿热", "entity_type": "病机", "start": 23, "end": 25}, {"surface_form": "上中焦", "entity_type": "病位", "start": 27, "end": 30}], "relations": [["脾瘅", "表现", "粘痰稠腻"], ["脾瘅", "表现", "气窒不利"], ["湿热", "涉及", "上中焦"], ["湿热", "导致", "脾瘅"]]}
{"ann_id": "ann_046", "record_id": "XK_000689", "text": "论曰脾土制水，通调水道，下输于膀胱，消渴饮水过度，内溃脾土，土不制水，故胃胀则为腹满之疾也，内经谓水为阴，腹者至阴之所居，是以水饮之证，先见于腹满。", "span_entities": [{"surface_form": "脾", "entity_type": "病位", "start": 2, "end": 3}, {"surface_form": "脾", "entity_type": "病位", "start": 27, "end": 28}, {"surface_form": "消渴", "entity_type": "疾病", "start": 18, "end": 20}, {"surface_form": "胃", "entity_type": "病位", "start": 36, "end": 37}, {"surface_form": "腹满", "entity_type": "症状", "start": 40, "end": 42}, {"surface_form": "腹满", "entity_type": "症状", "start": 71, "end": 73}], "relations": [["消渴", "表现", "腹满"]]}
{"ann_id": "ann_029", "record_id": "XK_002794", "text": "经症者何？消渴，气上撞心，心中疼热，饥而不欲食，食则吐蛔，下之利不止是也。夫厥阴之木气，从下起而上合于手厥阴包络，包络主火，风火相合为病。风火相煽，故能消；火盛津枯故见渴，包络为心之外垣，心包火动，故热气撞心而疼；木气太盛，上凌脾土，土畏木克，故饥而不欲食；蛔虫禀厥阴风木所化，故吐蛔；木既克土，土气大虚，若更下之，故利不止（是促其生化之机也）。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 5, "end": 7}, {"surface_form": "风火相煽", "entity_type": "病机", "start": 69, "end": 73}], "relations": [["风火相煽", "导致", "消渴"]]}
{"ann_id": "ann_043", "record_id": "XK_002413", "text": "答曰∶消渴者，热甚能消水也。邪传太阴，则嗌干，未甚渴也；至少阴，则口燥舌干而渴；至厥阴则消渴矣。消渴者，饮水多而小便少，不知消归何有也。可见厥阴热甚，则大渴而能消水也。", "span_entities": [{"surface_form": "消渴", "entity_type": "疾病", "start": 3, "end": 5}, {"surface_form": "消渴", "entity_type": "疾病", "start": 44, "end": 46}, {"surface_form": "消渴", "entity_type": "疾病", "start": 48, "end": 50}, {"surface_form": "饮水多", "entity_type": "症状", "start": 52, "end": 55}, {"surface_form": "小便少", "entity_type": "症状", "start": 56, "end": 59}], "relations": [["消渴", "表现", "饮水多"], ["消渴", "表现", "小便少"]]}
